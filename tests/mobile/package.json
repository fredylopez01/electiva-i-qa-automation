{
  "name": "reto-final-mobile-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Etapa 2 — Pruebas móviles con Appium (Reto Final Electiva I)",
  "type": "module",
  "scripts": {
    "test": "node scripts/with-appium.js",
    "test:headless": "node scripts/with-appium.js",
    "test:report": "node scripts/with-appium.js --report",
    "appium:start": "node node_modules/appium/build/lib/main.js --address 127.0.0.1 --port 4723",
    "appium:doctor": "node node_modules/appium/build/lib/main.js driver doctor uiautomator2",
    "emulator:start": "node scripts/start-emulator.js"
  },
  "devDependencies": {
    "@wdio/allure-reporter": "^9.4.3",
    "@wdio/appium-service": "^9.4.3",
    "@wdio/cli": "^9.4.3",
    "@wdio/local-runner": "^9.4.3",
    "@wdio/mocha-framework": "^9.4.3",
    "@wdio/spec-reporter": "^9.4.3",
    "allure-commandline": "^2.32.0",
    "appium": "^3.9.0",
    "appium-uiautomator2-driver": "^8.7.3",
    "webdriverio": "^9.4.3"
  }
}
