[3.008, "o", "tests/performance/stress/scripts/demo-sustentacion.sh: line 58: 81608 Terminated: 15          ( CSV=\"$STRESS_DIR/reports/$RUN/recursos.csv\"; sleep 15; while true; do\r\n    if [[ -f \"$CSV\" ]]; then\r\n        ps_line=$(grep 'prestashop-stress-prestashop' \"$CSV\" | tail -1 | awk -F, '{printf \"PrestaShop CPU %s%% mem %s PIDs %s\", $3, $4, $6}'); my_line=$(grep 'prestashop-stress-mysql' \"$CSV\" | tail -1 | awk -F, '{printf \"MySQL CPU %s%%\", $3}'); [[ -n \"$ps_line\" ]] && echo \"${C}  [recursos $(date +%H:%M:%S)] $ps_line | $my_line${R}\";\r\n    fi; sleep 10;\r\ndone )\r\n"]
